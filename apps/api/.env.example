# ---------------------------------------------------------------------------
# API environment. Copy to `.env` and fill in.
# ConfigModule validates these at boot (fail-fast).
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL. REQUIRED — the app will not boot without it.
DATABASE_URL=postgresql://user:password@host:5432/app?schema=public

# Comma-separated allowed CORS origins (empty disables cross-origin requests).
CORS_ORIGINS=http://localhost:3001
