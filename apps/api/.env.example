# ---------------------------------------------------------------------------
# IHRMS API environment. Copy to `.env` and fill in.
# ConfigModule validates these at boot (fail-fast).
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL. REQUIRED — the app will not boot without it.
DATABASE_URL=postgresql://user:password@host:5432/ihrms?schema=public

# Comma-separated allowed CORS origins (empty disables cross-origin requests).
CORS_ORIGINS=http://localhost:3001

# --- Auth (placeholders; wired in a later phase) ---
JWT_SECRET=
REFRESH_SECRET=
# Employee OTP time-to-live, seconds.
OTP_TTL=300

# --- Onboarding email / SMTP (placeholders) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Object storage for uploads (placeholders) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing — "true" for MinIO/local, "false" for AWS/R2.
S3_FORCE_PATH_STYLE=false
