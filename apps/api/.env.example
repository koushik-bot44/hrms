# ---------------------------------------------------------------------------
# CDPP API environment.
# Copy to `.env` and fill in. ConfigModule validates these at boot (fail-fast).
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL (Railway). REQUIRED — the app will not boot without it.
DATABASE_URL=postgresql://user:password@host:5432/cdpp?schema=public

# Comma-separated allowed CORS origins (empty disables cross-origin requests).
CORS_ORIGINS=http://localhost:3001

# --- The following are placeholders for later phases; empty values are accepted. ---

# Auth (Phase 2)
JWT_SECRET=
REFRESH_SECRET=

# Object storage / S3 (Phase 4)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OIDC SSO (Phase 2)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Background verification provider (later phase)
BGV_API_URL=
BGV_API_KEY=
