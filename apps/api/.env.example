# ---------------------------------------------------------------------------
# IHRMS API (Spring Boot) environment. Copy to `.env` (or export) and fill in.
# Every name here is exactly what the code reads (application.yml ${VAR:...},
# DatabaseUrlEnvironmentPostProcessor, FieldCrypto). Lines commented out are
# OPTIONAL — leave them commented rather than setting them to an empty value:
# an empty-but-set variable OVERRIDES the code default (e.g. JWT_SECRET= breaks
# token signing, while an absent JWT_SECRET falls back to the dev default).
# ---------------------------------------------------------------------------

# --- Core --------------------------------------------------------------------
PORT=8080
# 'local' relaxes cookies (insecure, SameSite=Lax) and enables the dev seeder;
# 'prod' enforces real secrets at boot and Secure + SameSite=None cookies.
SPRING_PROFILES_ACTIVE=local

# PostgreSQL. DATABASE_URL (libpq form) is translated to a JDBC URL on boot; or set
# SPRING_DATASOURCE_URL/_USERNAME/_PASSWORD explicitly (those take precedence).
DATABASE_URL=postgresql://user:password@localhost:5432/ihrms
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ihrms
# SPRING_DATASOURCE_USERNAME=user
# SPRING_DATASOURCE_PASSWORD=password

# Comma-separated allowed CORS origins (empty disables cross-origin requests).
CORS_ORIGINS=http://localhost:3001

# Public URL of the web app (used to build links in emails).
WEB_APP_URL=http://localhost:3001

# --- Auth ---------------------------------------------------------------------
# HS256 signing secrets (>=32 bytes). Unset locally = dev-insecure defaults; prod
# REFUSES TO BOOT on dev/blank values (StartupSecretsGuard). Never set them empty.
# JWT_SECRET=
# REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_COOKIE_NAME=ihrms_refresh
OTP_TTL=300
# Non-prod seeder overrides for the first SUPER_ADMIN (defaults: superadmin@ihrms / SuperAdmin@123).
# APP_SEED_SUPER_ADMIN_EMAIL=
# APP_SEED_SUPER_ADMIN_PASSWORD=

# --- Crypto (field-level encryption) -------------------------------------------
# AES-256-GCM passphrase for sensitive PII/financial columns (PAN, account, Aadhaar, salary).
# MUST stay the SAME key the existing data was encrypted with — a different key makes that
# data unreadable. Rotation: docs/runbooks/rotate-field-enc-key.md (REENCRYPT_* below).
# Unset locally = dev-insecure default; prod refuses to boot without a real value.
# FIELD_ENC_KEY=
# One-off re-key run AFTER rotating FIELD_ENC_KEY (enable for a single boot, then unset).
# REENCRYPT_FIELD_KEYS=true
# REENCRYPT_FROM_KEY=

# --- Mail (outbound SMTP) ------------------------------------------------------
# Blank/unset SMTP_HOST => no real mail; every email is written to the app log instead
# (DevLogMailer, "[DEV ...]" lines). Set the SMTP_* block for real delivery.
# SMTP_HOST=
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Port 465 implicit TLS => SMTP_SSL=true (and usually SMTP_STARTTLS=false).
SMTP_SSL=false
# Message identity: From header and Reply-To for notification mail.
# MAIL_FROM="hrorg.in <noreply@hrorg.in>"
# MAIL_REPLY_TO=support@hrorg.in
# Where public contact-form enquiries are delivered (default info@hrorg.in).
# CONTACT_INBOX=

# --- Storage (uploads) ----------------------------------------------------------
# 'db' (default; bytes live in Postgres, no bucket needed) or 's3' (uses the S3_* block).
STORAGE_DRIVER=db
# Absolute public base URL of THIS API for db-storage blob links; blank = derive from the request.
# STORAGE_PUBLIC_URL=
# Max accepted upload size for the db blob endpoint, in bytes (10 MiB).
STORAGE_MAX_BYTES=10485760
# Optional: LibreOffice binary for Word->PDF letterhead conversion (blank = Word uploads refused).
# IHRMS_LIBREOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice

# S3-compatible object storage — used only when STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing — "true" for MinIO/local, "false" for AWS/R2.
S3_FORCE_PATH_STYLE=false

# --- Web Push / OS notifications (VAPID) ----------------------------------------
# Generate a keypair with:  npx web-push generate-vapid-keys
# Set all three in the environment (Railway); NEVER commit real values. Blank => Web Push is simply
# DISABLED (logged) — it never blocks startup, since push is an optional add-on. SUBJECT must be a
# mailto: (or https:) contact URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Attendance ------------------------------------------------------------------
# Long-open-break HR alert (§8a): alert when a break stays open longer than this many minutes.
BREAK_ALERT_MINUTES=35
# How often the break scanner runs, in milliseconds (single-instance job).
BREAK_ALERT_SCAN_MS=300000

# --- eSSL/ZKTeco ADMS biometric ingest (iClock push, Phase 0) ---
# The terminal speaks PLAIN HTTP with no TLS and no authentication, so it can only reach an instance
# on its own LAN. Leave ICLOCK_ENABLED unset (false) on the public deployment: the /iclock endpoints
# still answer text/plain there, but nothing is persisted. Set it to true only on the LAN box.
# The V41 tables are created by Flyway regardless of this flag.
ICLOCK_ENABLED=false
# DoS bound: max bytes read from a device push (there is no server-wide request-size limit).
ICLOCK_MAX_BODY_BYTES=262144
# Generous per-IP ceiling; well above any real terminal's poll rate so a device is never throttled.
ICLOCK_RATE_LIMIT_PER_MINUTE=600
# "count" -> reply "OK: <n>" to an ATTLOG push (per spec); "plain" -> bare "OK". Some firmware differs.
ICLOCK_ACK_FORMAT=count
# Capture verbosity: 'full' (default) keeps every request body; 'lean' drops the body for mapped command
# polls only. Flip to lean after live push is verified. Note a poll body is already empty, so the real
# volume lever is retention/pruning, not this flag.
ICLOCK_CAPTURE_MODE=full
# THE DEVICE COMMAND CHANNEL (P3) — the only flag that gates a WRITE TO HARDWARE. Keep false except
# for a supervised canary; with it false the queue may fill but nothing is ever served to a terminal.
ICLOCK_COMMANDS_ENABLED=false
# Most PENDING commands one terminal may hold before another is refused (sized for a full name sync).
ICLOCK_MAX_PENDING_COMMANDS=1000
# Serves without an acknowledgement before a command gives up and surfaces to the operator.
ICLOCK_MAX_COMMAND_SERVES=3
# How often the request-log retention job runs, in milliseconds (property-only knob; default 1h).
# APP_ICLOCK_RETENTION_SCAN_MS=3600000
# --- P1a ---
# Burst collapse window: repeat taps by one person on one device inside this many seconds become a
# single effective punch (IN keeps the first, OUT keeps the latest). Must be > 1.
ICLOCK_BURST_WINDOW_SECONDS=120
# Self-announce caps for the unauthenticated /iclock surface. Over-cap requests get 200 OK text/plain
# and are not stored (never a 503 — a real terminal would retry forever).
ICLOCK_MAX_UNCLAIMED_DEVICES=10
ICLOCK_UNCLAIMED_SERIAL_PUNCH_CAP=50000
# Retention applies to iclock_request_logs ONLY. Punches are never deleted by retention.
ICLOCK_LOG_RETENTION_DAYS=7
ICLOCK_NULL_BODIES_AFTER_TWO_DAYS=false
# One-off: derive effective punches from all existing raw history. Idempotent; enable for ONE boot.
ICLOCK_BACKFILL=false
# One-off backfill: re-parse ATTLOG bodies already captured in iclock_request_logs into iclock_raw_punches
# (needed for pushes that landed on the catch-all before the .aspx paths were mapped). Idempotent — a
# content-dedupe unique index makes a repeat run a no-op. Enable for ONE boot, read the counts, then unset.
ICLOCK_REPLAY=false
# Handshake options block. Realtime=1 is what enables live push rather than scheduled batch upload.
# Tune these against a real device once its dialect is confirmed; no code change needed.
ICLOCK_ERROR_DELAY=30
ICLOCK_DELAY=30
ICLOCK_TRANS_TIMES=00:00;14:05
ICLOCK_TRANS_INTERVAL=1
ICLOCK_TRANS_FLAG=1111000000
# INTEGER OFFSET IN MINUTES — 330 = +05:30. Never fractional hours: "5.5" is truncated to 5 by this
# firmware, leaving the terminal 30 minutes slow and mis-stamping every punch. Verified on hardware.
ICLOCK_TIME_ZONE=330
ICLOCK_REALTIME=1
ICLOCK_ENCRYPT=0
# pushver 2.4.1 terminals commonly look for a server version line; blank omits it.
ICLOCK_SERVER_VER=2.4.1
