// CDPP database schema.
//
// Prisma owns the PostgreSQL enums below. They MUST match `@cdpp/shared` exactly —
// `src/contract/enum-parity.spec.ts` asserts parity so the two can never silently drift.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (mirror of @cdpp/shared enums)
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  HR_OPERATOR
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum WorkAuthStatus {
  CITIZEN
  PERMANENT_RESIDENT
  WORK_VISA
  PENDING
  NOT_AUTHORIZED
}

enum OnboardingState {
  INVITED
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
  REJECTED
  // Full intended onboarding lifecycle (additive — existing members retained):
  SUBMITTING
  UNDER_REVIEW
  PENDING_COMPLIANCE
  READY
  ACTIVE
  EXITED
}

enum DocumentClass {
  LETTER
  AGREEMENT
  CERTIFICATE
  VERIFICATION
}

enum DocumentStatus {
  DRAFT
  PENDING
  ISSUED
  SIGNED
  REVOKED
  // Full intended document set (additive — existing members retained):
  PENDING_APPROVAL
  SUPERSEDED
}

// How a document entered the system (distinct from DocumentClass). The status
// machine governs ISSUED only; COLLECTED/REFERENCED never get a uniqueId.
enum ProvisioningClass {
  ISSUED
  COLLECTED
  REFERENCED
}

enum RequirementStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  WAIVED
}

enum ConsentKind {
  BACKGROUND_CHECK
  DATA_PROCESSING
  ELECTRONIC_SIGNATURE
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// An employer / organization. `code` is the {ENTITY} segment of document unique IDs.
model Entity {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     User[]
  documents Document[]

  @@map("entities")
}

/// A platform user: an operator or an employee being onboarded.
model User {
  id              String           @id @default(cuid())
  email           String           @unique
  fullName        String
  role            Role             @default(EMPLOYEE)
  employmentType  EmploymentType?
  workAuthStatus  WorkAuthStatus?
  onboardingState OnboardingState  @default(INVITED)
  entity          Entity           @relation(fields: [entityId], references: [id])
  entityId        String
  documents       Document[]       @relation("DocumentOwner")
  requirements    Requirement[]
  consents        Consent[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([entityId])
  @@map("users")
}

/// A vault record across all three provisioning classes. ISSUED docs get a
/// `uniqueId` (`{ENTITY}-{TYPE}-{YYYY}-{NNNNNN}`) and run the status machine;
/// COLLECTED/REFERENCED docs leave `uniqueId`/`status` null.
/// `ownerId` is the consultant the document belongs to.
model Document {
  id                String            @id @default(cuid())
  provisioningClass ProvisioningClass
  typeCode          String? // one of @cdpp/shared DocumentTypeCode (OFR, EXP, ...)
  class             DocumentClass? // doc-type category, set for ISSUED docs
  status            DocumentStatus? // status machine — ISSUED-class only, else null
  uniqueId          String?           @unique
  title             String?

  // Content-addressed storage + integrity (latest version mirrored here).
  storageKey   String? // opaque object key — NEVER returned to clients
  sha256       String?
  mimeType     String?
  accessPolicy String  @default("PRIVATE")

  // REFERENCED (external check) docs.
  providerRef String?

  // Supersession lineage (ISSUED). `supersededById` → the successor that replaced this doc.
  supersededById String?
  supersededBy   Document?  @relation("Supersession", fields: [supersededById], references: [id])
  supersedes     Document[] @relation("Supersession")

  owner    User              @relation("DocumentOwner", fields: [ownerId], references: [id])
  ownerId  String
  entity   Entity            @relation(fields: [entityId], references: [id])
  entityId String
  versions DocumentVersion[]

  issuedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([entityId])
  @@index([ownerId])
  @@index([provisioningClass])
  @@map("documents")
}

/// Immutable version history. Each (re)upload appends a row with a fresh sha256;
/// old versions stay queryable.
model DocumentVersion {
  id         String   @id @default(cuid())
  document   Document @relation(fields: [documentId], references: [id])
  documentId String
  version    Int
  sha256     String
  mimeType   String?
  storageKey String
  createdAt  DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

/// Per (entity, typeCode, year) monotonic counter for unique-ID allocation.
/// Incremented inside a row-locked transaction so parallel allocations can't collide.
model DocumentSequence {
  id        String   @id @default(cuid())
  entityId  String
  typeCode  String
  year      Int
  lastSeq   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, typeCode, year])
  @@map("document_sequences")
}

/// Append-only audit ledger. A Prisma client extension forbids update/delete/upsert
/// on this table; nothing in the app exposes a mutation path.
model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  actorType  String // SYSTEM | OPERATOR | ...
  actorId    String?
  targetType String?
  targetId   String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_events")
}

/// A document/onboarding requirement tracked per user.
model Requirement {
  id        String            @id @default(cuid())
  user      User              @relation(fields: [userId], references: [id])
  userId    String
  class     DocumentClass
  status    RequirementStatus @default(PENDING)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId])
  @@map("requirements")
}

/// A consent record captured from a user.
model Consent {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id])
  userId    String
  kind      ConsentKind
  grantedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@map("consents")
}
