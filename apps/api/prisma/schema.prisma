// IHRMS database schema (ARCHITECTURE.md §4, §5, §7).
//
// Prisma owns the PostgreSQL enums below. They MUST match `@ihrms/shared` exactly —
// `src/contract/enum-parity.spec.ts` asserts parity so the two can never silently drift.
// Schema is ADDITIVE-ONLY from here: add models/columns/enum values; never drop/rename.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (mirror of @ihrms/shared enums)
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR
  MANAGER
}

enum EmployeeStatus {
  INVITED
  IN_PROGRESS
  SUBMITTED
  HR_VERIFIED
  APPROVED
  REJECTED
}

enum SectionKey {
  PERSONAL
  BACKGROUND
  GOVERNMENT
}

enum SectionStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  REJECTED
}

enum DocumentType {
  EXPERIENCE_LETTER
  PAN
  AADHAAR
  BGV_DOCUMENT
  OTHER
}

enum DocumentStatus {
  PENDING
  UPLOADED
  VERIFIED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  EMPLOYEE_ONBOARDED
  EMPLOYEE_SUBMITTED
  APPROVAL_REQUESTED
  EMPLOYEE_APPROVED
  EMPLOYEE_REJECTED
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

/// Staff/operator account (distinct from Employee). Auth = email + password (§6).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         UserRole
  companyId    String? // null for SUPER_ADMIN
  company      Company? @relation(fields: [companyId], references: [id])
  teamId       String? // home team for HR/Manager
  team         Team?    @relation("TeamMembers", fields: [teamId], references: [id])
  passwordHash String? // staff credential (argon2/bcrypt) — §6
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  onboardedEmployees Employee[]        @relation("OnboardingHr")
  hrTeams            Team[]            @relation("TeamHr")
  managerTeams       Team[]            @relation("TeamManager")
  approvalsAsHr      ApprovalRequest[] @relation("ApprovalHr")
  approvalsAsManager ApprovalRequest[] @relation("ApprovalManager")
  notifications      Notification[]

  @@index([companyId])
  @@index([teamId])
  @@map("users")
}

/// The onboarded subject. Auth = unique employeeCode + email + OTP (§6).
model Employee {
  id             String         @id @default(cuid())
  employeeCode   String         @unique // {COMPANY_CODE}-EMP-{NNNNNN} (§5)
  email          String
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  onboardingHrId String
  onboardingHr   User           @relation("OnboardingHr", fields: [onboardingHrId], references: [id])
  status         EmployeeStatus @default(INVITED)
  otpHash        String? // single-use, time-boxed OTP (§6)
  otpExpiresAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sections         ProfileSection[]
  documents        Document[]
  approvalRequests ApprovalRequest[]
  notifications    Notification[]

  @@index([companyId])
  @@index([onboardingHrId])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // short mnemonic (e.g. ACME) — used in the employee ID
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  teams     Team[]
  employees Employee[]
  sequences EmployeeCodeSequence[]

  @@map("companies")
}

/// A team within a company. The single hrUserId/managerUserId columns structurally
/// enforce "exactly one HR + one Manager"; they are nullable so a team can be created
/// first and have its HR/Manager assigned afterwards (§3.1).
model Team {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  hrUserId      String?
  hr            User?    @relation("TeamHr", fields: [hrUserId], references: [id])
  managerUserId String?
  manager       User?    @relation("TeamManager", fields: [managerUserId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members          User[]            @relation("TeamMembers")
  approvalRequests ApprovalRequest[]

  @@index([companyId])
  @@index([hrUserId])
  @@index([managerUserId])
  @@map("teams")
}

// ---------------------------------------------------------------------------
// Employee record
// ---------------------------------------------------------------------------

/// One row per section per employee (extensible by adding SectionKey values).
model ProfileSection {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  key        SectionKey
  data       Json? // structured field values for the tab
  status     SectionStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([employeeId, key])
  @@index([employeeId])
  @@map("profile_sections")
}

/// Uploaded file, always stored under the employee record. `storageKey` is never exposed raw.
model Document {
  id         String         @id @default(cuid())
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id])
  sectionKey SectionKey
  docType    DocumentType
  fileName   String
  storageKey String
  mimeType   String
  sha256     String?
  status     DocumentStatus @default(UPLOADED)
  uploadedAt DateTime       @default(now())

  @@index([employeeId])
  @@index([employeeId, sectionKey])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Verification & approval
// ---------------------------------------------------------------------------

model ApprovalRequest {
  id            String         @id @default(cuid())
  employeeId    String
  employee      Employee       @relation(fields: [employeeId], references: [id])
  hrUserId      String
  hr            User           @relation("ApprovalHr", fields: [hrUserId], references: [id])
  managerUserId String
  manager       User           @relation("ApprovalManager", fields: [managerUserId], references: [id])
  teamId        String
  team          Team           @relation(fields: [teamId], references: [id])
  status        ApprovalStatus @default(PENDING)
  note          String?
  submittedAt   DateTime       @default(now())
  decidedAt     DateTime?

  @@index([employeeId])
  @@index([managerUserId])
  @@index([teamId])
  @@map("approval_requests")
}

model Notification {
  id              String           @id @default(cuid())
  recipientUserId String
  recipient       User             @relation(fields: [recipientUserId], references: [id])
  type            NotificationType
  employeeId      String?
  employee        Employee?        @relation(fields: [employeeId], references: [id])
  read            Boolean          @default(false)
  createdAt       DateTime         @default(now())

  @@index([recipientUserId])
  @@index([employeeId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Audit (append-only, partitioned per company — §7)
// ---------------------------------------------------------------------------

/// `companyId` is the partition key (null only for portal/system events). Append-only:
/// a Prisma client extension forbids update/delete/upsert. No FK so logs outlive entities.
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  actorType  String // USER | EMPLOYEE | SYSTEM
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Employee-code allocation (per-company, atomic — §5)
// ---------------------------------------------------------------------------

/// One monotonic counter per company. Allocate the next code inside a row-locked
/// `INSERT … ON CONFLICT ("companyId") DO UPDATE SET lastSeq = lastSeq + 1 RETURNING`
/// so parallel onboarding can't collide.
model EmployeeCodeSequence {
  id        String   @id @default(cuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id])
  lastSeq   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employee_code_sequences")
}
