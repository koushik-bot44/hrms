# --- Browser-side API base (shipped to the client) ---------------------------
# Where the browser sends API calls. Two modes:
#
#  * Production (same-origin proxy): set this to `/api`. Combined with API_ORIGIN
#    below, calls go to <this site>/api/* and are reverse-proxied to the real API,
#    which keeps the login (refresh) cookie FIRST-PARTY so mobile browsers don't
#    drop it on app close. This is the setup that keeps you signed in on mobile.
#
#  * Local dev: point it straight at the dev API (no proxy needed — localhost is
#    same-site, so the cookie persists anyway).
#
# Defaults to `/api` when unset.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Server-side proxy target (NEVER shipped to the browser) ------------------
# The real API origin that `/api/*` is reverse-proxied to (production only). Leave
# UNSET locally to disable the proxy. Example (production):
# API_ORIGIN=https://docprov-platform-production.up.railway.app
